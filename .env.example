TELEGRAM_BOT_TOKEN=put_token_from_BotFather
TELEGRAM_CHAT_ID=put_your_chat_id

# MongoDB (keeps your data safe across Render redeploys).
# Local dev: leave MONGODB_URI empty and the bot uses the history/ folder.
# Render: paste your MongoDB Atlas connection string, e.g.
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
MONGODB_DB=hostel_bot
